---
import MainLayout from "../layouts/MainLayout.astro";
import EventsGrid from '../components/EventsGrid.astro';
import { getCollection } from "astro:content";
import { safeLink } from "../utils/url";

const eventsData = (await getCollection("events")).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Shape into plain objects that EventsGrid already expects
const events = eventsData.map((e) => ({
  id: e.id,
  title: e.data.title,
  date: e.data.date,
  time: e.data.time,
  location: e.data.location,
  organizer: e.data.organizer,
  image: e.data.image ?? null,
  description: e.data.description,
  link: safeLink(e.data.link),
}));
---
<MainLayout title="Events">
  <main class="bg-[#0b1221] text-white">
    <EventsGrid events={events} />
  </main>
</MainLayout>
