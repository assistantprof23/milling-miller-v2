---
import '../styles/global.css';
const siteName = 'Milling and Miller';
const { title } = Astro.props;
const pageTitle = title && title !== siteName ? `${title} | ${siteName}` : siteName;
const rawBase = String((import.meta as any).env?.BASE_URL ?? "/");
const baseUrl = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const withBase = (path) => `${baseUrl}${path.replace(/^\//, '')}`;
---
<html lang="en" class="theme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href={withBase('/logo.png')} />
    <!-- ...existing head content... -->
    <!-- preconnect fonts for faster load -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- keep font loads in theme.css (import) -->
  </head>
  <body class="bg-theme text-theme antialiased">
    <slot />
    <!-- ...existing scripts/footer... -->
  </body>
</html>
