---
import { getCollection } from 'astro:content';
import styles from '../styles/Home.module.css';
const baseUrl = (import.meta as any).env?.BASE_URL ?? '/';
const withBase = (path) => `${baseUrl}${path.replace(/^\//, '')}`;

const allPosts = (await getCollection('news')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const latest = allPosts.slice(0, 3);
---
<section class={styles.marketInsightsSection}>
  <h2>Market Insights</h2>

  <div class={styles.marketGrid}>
    {latest.map((post) => (
      <a class={styles.marketCard} href={withBase(`/news/${post.id.replace(/\.md$/, '')}`)} key={post.id}>
        <div
          class={styles.cardImage}
          style={`background-image: url('${post.data.image ?? '/default-image.jpg'}')`}
        >
          <div class={styles.cardOverlay}>
            <h3 class={styles.cardTitle}>{post.data.title}</h3>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
