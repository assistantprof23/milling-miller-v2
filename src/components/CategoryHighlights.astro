---
import { getCollection } from 'astro:content';
const baseUrl = (import.meta as any).env?.BASE_URL ?? '/';
const withBase = (path) => `${baseUrl}${path.replace(/^\//, '')}`;
const allPosts = (await getCollection('news')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const latest = allPosts.slice(0, 3);
---
<section class="max-w-7xl mx-auto py-16 px-6">
  <h2 class="text-3xl font-bold mb-8">Market Highlights</h2>

  <div class="grid md:grid-cols-3 gap-8">
    {latest.map((post) => (
      <div class="bg-white p-6 rounded-xl shadow hover:shadow-lg transition">
        <div
          class="w-full h-40 rounded-md mb-4 bg-cover bg-center"
          style={`background-image: url('${post.data.image ?? '/default-image.jpg'}')`}
          role="img"
          aria-label={post.data.title}
        />
        <h3 class="text-xl font-semibold mb-2 text-green-700">{post.data.title}</h3>
        <p class="text-gray-600 mb-4">
          {post.data.summary ?? ''}
        </p>
        <a href={withBase(`/news/${post.id.replace(/\.md$/, '')}`)} class="text-green-600 font-medium">
          Read more →
        </a>
      </div>
    ))}
  </div>
</section>