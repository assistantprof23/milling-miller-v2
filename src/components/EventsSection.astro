---
import { getCollection } from "astro:content";

const baseUrl = (import.meta as any).env?.BASE_URL ?? "/";
const withBase = (path) => `${baseUrl}${path.replace(/^\//, "")}`;

const upcomingEvents = (await getCollection("events"))
  .sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf())
  .slice(0, 3);
---

<section class="py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-semibold text-white">Upcoming Events</h2>
      <a class="text-sm text-indigo-300 hover:underline" href={withBase("/events")}>See all events</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {upcomingEvents.map((ev) => {
        const [year, month, day] = ev.data.date.split('-');
        const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const monthLabel = monthNames[parseInt(month, 10) - 1] ?? month;
        return (
          <article class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition">
            <div class="p-4">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0">
                  <div class="text-center bg-gray-700 text-indigo-200 rounded-md px-3 py-2 text-sm font-semibold">
                    <div class="text-xs">{monthLabel}</div>
                    <div class="text-lg">{day}</div>
                  </div>
                </div>
                <div class="flex-1">
                  <h3 class="text-lg font-medium text-white">{ev.data.title}</h3>
                  <div class="mt-1 text-sm text-gray-300">{ev.data.location} • {ev.data.time}</div>
                </div>
              </div>

              <p class="mt-3 text-sm text-gray-300">{ev.data.description}</p>

              <div class="mt-4 flex items-center justify-between">
                <div class="text-sm text-gray-400">{ev.data.organizer}</div>
                <a class="inline-flex items-center px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-md hover:bg-indigo-500" href={ev.data.link ?? '#'}>Register</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>