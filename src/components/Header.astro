---
/* Import global styles once in the shared header so client-side navigation keeps styles loaded */
import "../styles/global.css";
import ads from "../data/ads.json";

const baseUrl = (import.meta as any).env?.BASE_URL ?? "/";
const withBase = (path) => {
  const base = String(baseUrl).endsWith("/")
    ? String(baseUrl)
    : `${String(baseUrl)}/`;
  const clean = String(path).replace(/^\//, "");
  return `${base}${clean}`;
};

const subscribeHref = `mailto:millingandmiller@gmail.com?subject=${encodeURIComponent(
  "Subscription Request"
)}&body=${encodeURIComponent("Please subscribe me to the newsletter")}`;
---

<header id="site-header" class="site-header bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto p-3 sm:p-4">
      <div class="flex items-center justify-between gap-3">
        <a href={withBase("/")} aria-label="Milling & Millers homepage" class="inline-block shrink-0">
          <img src={withBase("/logo.png")} alt="Milling & Millers" class="h-12 sm:h-20 md:h-24 w-auto cursor-pointer" />
        </a>

        <div class="ml-auto min-w-0 bg-transparent rounded text-sm">
          <a href={ads.header.href} target="_blank" rel="noopener noreferrer" aria-label={ads.header.alt}>
            <img src={ads.header.imageSrc} alt={ads.header.alt} class="h-10 sm:h-14 md:h-20 w-auto max-w-full object-contain" />
          </a>
        </div>

        <button
          id="nav-toggle"
          type="button"
          class="lg:hidden shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-md border border-gray-700 hover:bg-gray-800"
          aria-controls="primary-nav"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path class="nav-icon-open" d="M4 6h16M4 12h16M4 18h16" />
            <path class="nav-icon-close hidden" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <nav
        id="primary-nav"
        aria-label="Primary navigation"
        class="mt-3 hidden data-[open=true]:flex lg:flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-6 font-medium text-base"
      >
        <a href={withBase("/")} class="py-2 lg:py-0 hover:text-green-600">Home</a>
        <a href={withBase("/news")} class="py-2 lg:py-0 hover:text-green-600">News</a>
        <a href={withBase("/press-releases")} class="py-2 lg:py-0 hover:text-green-600">Press Releases</a>
        <a href={withBase("/policies")} class="py-2 lg:py-0 hover:text-green-600">Policies</a>
        <a href={withBase("/machinery")} class="py-2 lg:py-0 hover:text-green-600">Marketplace</a>
        <a href={withBase("/events")} class="py-2 lg:py-0 hover:text-green-600">Events</a>
        <a href={withBase("/contact")} class="py-2 lg:py-0 hover:text-green-600">Contact</a>
        <a
          href={subscribeHref}
          class="mt-2 lg:mt-0 lg:ml-auto justify-center inline-flex items-center px-3 py-2 lg:py-1.5 bg-green-600 hover:bg-green-500 text-white text-sm font-semibold rounded-md"
        >
          Subscribe to Newsletter
        </a>
      </nav>
    </div>

  </header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = nav.dataset.open !== "true";
      nav.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector(".nav-icon-open")?.classList.toggle("hidden", open);
      toggle.querySelector(".nav-icon-close")?.classList.toggle("hidden", !open);
    });
  }
</script>
